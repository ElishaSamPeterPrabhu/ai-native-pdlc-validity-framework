    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst reviewId = String(body.reviewId ?? '').trim();\nif (!reviewId) throw new Error('reviewId is required.');\nif (!body.chatResponse) throw new Error('chatResponse is required.');\nreturn [{ json: {\n  reviewId,\n  docId: body.docId ?? null,\n  docUrl: body.docUrl ?? null,\n  items: (Array.isArray(body.items) ? body.items : []).map((item) => ({ ...item, itemId: item.itemId ?? item.id })),\n  chatResponse: body.chatResponse,\n  status: 'review_ready',\n  reviewComment: '',\n  updatedAt: new Date().toISOString()\n} }];"
      },
      "id": "f0d9a0d7-6b6a-4c6c-a8b4-4c0c01a9b102",
      "name": "Normalize Review Ready",
      "type": "n8n-nodes-base.code",
