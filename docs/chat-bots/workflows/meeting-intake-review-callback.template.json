        "specifyBody": "json",
        "jsonBody": "={{ { repo: 'ElishaSamPeterPrabhu/modus-wc-2.0', title: $json.item.rawText, summary: $json.item.sourceExcerpt || $json.item.reason, type: $json.item.classification === 'design-work' ? 'design' : 'feature', components: $json.item.componentHints || [], labels: $json.item.classification === 'design-work' ? ['needs-scaffolding', 'design-research'] : ['needs-scaffolding'], source: { kind: 'gemini-notes', threadName: $json.reviewId }, rawConversation: [{ sender: 'Gemini meeting notes', text: $json.item.rawText }], contextEvidence: $json.item.evidence || [], additionalContext: { reviewComment: $json.reviewComment }, idempotencyKey: $json.item.idempotencyKey, autoApprove: false } }}",
        "options": {
          "timeout": 30000
        }
      },
