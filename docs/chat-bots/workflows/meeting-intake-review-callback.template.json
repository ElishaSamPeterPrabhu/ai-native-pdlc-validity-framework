    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst decision = String(body.decision ?? '').trim();\nconst reviewId = String(body.reviewId ?? '').trim();\nif (!reviewId || !decision) throw new Error('reviewId and decision are required.');\nif (!['approve_selected', 'reject_selected', 'request_changes', 'discard_review'].includes(decision)) throw new Error('Unsupported review decision.');\nreturn [{ json: { reviewId, decision, selectedItemIds: Array.isArray(body.selectedItemIds) ? body.selectedItemIds : [], comment: String(body.comment ?? ''), updatedAt: new Date().toISOString() } }];"
      },
      "id": "f0d9a0d7-6b6a-4c6c-a8b4-4c0c01a9b107",
      "name": "Normalize Review Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        520
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "meeting_review_state",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "reviewId",
              "condition": "eq",
              "keyValue": "={{ $('Normalize Review Action').item.json.reviewId }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "id": "f0d9a0d7-6b6a-4c6c-a8b4-4c0c01a9b108",
      "name": "Load Review State",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        720,
        520
      ],
      "notes": "Reads the durable review state before applying the approval decision."
    },
    {
      "parameters": {
        "jsCode": "const action = $('Normalize Review Action').item.json;\nconst rows = $input.all().map((item) => item.json);\nif (!rows.length) throw new Error('Review state was not found.');\nconst review = rows[0];\nconst items = JSON.parse(review.itemsJson || '[]').map((item) => {\n  const itemId = item.itemId ?? item.id;\n  const rawText = item.rawText ?? item.rawExcerpt ?? '';\n  return {\n    ...item,\n    itemId,\n    rawText,\n    sourceExcerpt: item.sourceExcerpt ?? item.rawExcerpt ?? item.reason ?? '',\n    idempotencyKey: item.idempotencyKey ?? `gemini:${review.docId}:${itemId}`\n  };\n});\nif (action.decision === 'request_changes') {\n  return [{ json: {\n    route: 'rerun',\n    reviewId: action.reviewId,\n    cursorPayload: {\n      reviewId: action.reviewId,\n      docId: review.docId,\n      docUrl: review.docUrl,\n      previousItems: items,\n      reviewComment: action.comment,\n      reviewReadyCallbackUrl: 'https://flows-webhook.stage.trimble-ai.com/agentic/workflows/v1/webhook/pilot-meeting-review-ready',\n      revision: Date.now()\n    }\n  } }];\n}\nif (action.decision !== 'approve_selected') {\n  return [{ json: { route: 'review_update', response: { ok: true, status: action.decision, reviewId: action.reviewId, issueCreation: false } } }];\n}\nconst selected = new Set(action.selectedItemIds);\nconst approved = items.filter((item) => selected.has(item.itemId ?? item.id) && item.createEligible && ['repo-work', 'design-work'].includes(item.classification));\nif (!approved.length) {\n  return [{ json: { route: 'review_update', response: { ok: true, status: 'no_eligible_items', reviewId: action.reviewId, issueCreation: false } } }];\n}\nreturn approved.map((item) => ({ json: { route: 'create', reviewId: action.reviewId, reviewComment: action.comment, item: { ...item, itemId: item.itemId ?? item.id } } }));"
      },
      "id": "f0d9a0d7-6b6a-4c6c-a8b4-4c0c01a9b109",
      "name": "Build Approved Issue Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        520
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://flows-webhook.stage.trimble-ai.com/agentic/workflows/v1/webhook/pilot-modus-issue-service",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
