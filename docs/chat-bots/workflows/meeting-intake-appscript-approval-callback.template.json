{
  "name": "[PILOT] Meeting Intake Approval Callback (Apps Script)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pilot-meeting-review-approval",
        "responseMode": "responseNode",
