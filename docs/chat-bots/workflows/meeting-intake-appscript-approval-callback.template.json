      "id": "g0d9a0d7-6b6a-4c6c-a8b4-4c0c01a9e101",
      "name": "Meeting Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst reviewId = String(body.reviewId ?? '').trim();\nconst decision = String(body.decision ?? '').trim();\nif (!reviewId || !decision) throw new Error('reviewId and decision are required.');\nif (!['approve_selected', 'reject_selected', 'request_changes', 'discard_review'].includes(decision)) throw new Error('Unsupported review decision.');\nconst items = Array.isArray(body.items) ? body.items.map((item) => ({ ...item, itemId: item.itemId ?? item.id })) : [];\nreturn [{ json: { reviewId, decision, selectedItemIds: Array.isArray(body.selectedItemIds) ? body.selectedItemIds : [], comment: String(body.comment ?? ''), docId: body.docId ?? null, docUrl: body.docUrl ?? null, items, reviewProxyUrl: body.reviewProxyUrl ?? null, updatedAt: new Date().toISOString() } }];"
      },
      "id": "g0d9a0d7-6b6a-4c6c-a8b4-4c0c01a9e102",
      "name": "Normalize Approval Payload",
      "type": "n8n-nodes-base.code",
