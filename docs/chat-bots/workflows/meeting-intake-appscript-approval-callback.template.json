          "value": {
            "reviewId": "={{ $('Normalize Approval Payload').item.json.reviewId }}",
            "docId": "={{ $('Normalize Approval Payload').item.json.docId }}",
            "docUrl": "={{ $('Normalize Approval Payload').item.json.docUrl }}",
            "itemsJson": "={{ JSON.stringify($('Normalize Approval Payload').item.json.items) }}",
            "decision": "={{ $('Normalize Approval Payload').item.json.decision }}",
            "reviewComment": "={{ $('Normalize Approval Payload').item.json.comment }}",
            "status": "={{ $('Normalize Approval Payload').item.json.decision }}",
            "lastUpdatedAt": "={{ $('Normalize Approval Payload').item.json.updatedAt }}"
          },
