    },
    {
      "parameters": {
        "jsCode": "const input = $('Normalize Approval Payload').item.json;\nconst items = input.items || [];\nif (input.decision === 'request_changes') {\n  return [{ json: { route: 'rerun', cursorPayload: { reviewId: input.reviewId, docId: input.docId, docUrl: input.docUrl, previousItems: items, reviewComment: input.comment, reviewProxyUrl: input.reviewProxyUrl, revision: Date.now() } } }];\n}\nif (input.decision !== 'approve_selected') return [{ json: { route: 'no_create', response: { ok: true, status: input.decision, reviewId: input.reviewId, issueCreation: false } } }];\nconst selected = new Set(input.selectedItemIds);\nconst approved = items.filter((item) => selected.has(item.itemId ?? item.id) && item.createEligible && ['repo-work', 'design-work'].includes(item.classification));\nif (!approved.length) return [{ json: { route: 'no_create', response: { ok: true, status: 'no_eligible_items', reviewId: input.reviewId, issueCreation: false } } }];\nreturn approved.map((item) => ({ json: { route: 'create', reviewId: input.reviewId, reviewComment: input.comment, item: { ...item, itemId: item.itemId ?? item.id, rawText: item.rawText ?? item.rawExcerpt ?? '', sourceExcerpt: item.sourceExcerpt ?? item.rawExcerpt ?? item.reason ?? '', idempotencyKey: item.idempotencyKey ?? `gemini:${input.docId}:${item.itemId ?? item.id}` }, docId: input.docId, docUrl: input.docUrl } }));"
      },
      "id": "g0d9a0d7-6b6a-4c6c-a8b4-4c0c01a9e105",
      "name": "Build Approved Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "approval-rerun",
              "leftValue": "={{ $json.route }}",
              "rightValue": "rerun",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
