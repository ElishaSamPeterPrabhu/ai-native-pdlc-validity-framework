      "typeVersion": 4.2,
      "position": [
        1680,
        160
      ],
      "notes": "Async re-review. Cursor sends the next review to Apps Script using reviewProxyUrl."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://flows-webhook.stage.trimble-ai.com/agentic/workflows/v1/webhook/pilot-modus-issue-service",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_ISSUE_SERVICE_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { repo: 'ElishaSamPeterPrabhu/modus-wc-2.0', title: $json.item.rawText, summary: $json.item.sourceExcerpt || $json.item.reason, type: $json.item.classification === 'design-work' ? 'design' : 'feature', components: $json.item.componentHints || [], labels: $json.item.classification === 'design-work' ? ['needs-scaffolding', 'design-research'] : ['needs-scaffolding'], source: { kind: 'gemini-notes', url: $json.docUrl, meetingDocId: $json.docId }, rawConversation: [{ sender: 'Gemini meeting notes', text: $json.item.rawText }], contextEvidence: $json.item.evidence || [], additionalContext: { reviewComment: $json.reviewComment }, idempotencyKey: $json.item.idempotencyKey, autoApprove: false } }}",
        "options": {
          "timeout": 30000
        }
      },
