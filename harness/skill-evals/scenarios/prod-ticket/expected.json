{
  "checks": [
    {"id": "art.repo_profile", "group": "artifacts", "critical": true, "type": "schema_valid", "name": "repo-profile.json", "schema": "framework/schemas/repo-profile.schema.json"},
    {"id": "art.process_map", "group": "artifacts", "critical": true, "type": "schema_valid", "name": "process-map.json", "schema": "framework/schemas/process-map.schema.json"},
    {"id": "art.design", "group": "artifacts", "critical": true, "type": "schema_valid", "name": "workflow-design.json", "schema": "framework/schemas/workflow-design.schema.json"},
    {"id": "art.automations", "group": "artifacts", "critical": true, "type": "artifact_exists", "name": "*automations/*.md"},

    {"id": "str.product_flow", "group": "structure", "critical": true, "type": "json_includes", "name": "workflow-design.json", "pointer": "stages[*].flow", "values": ["product_to_issue"]},
    {"id": "str.three_rounds", "group": "structure", "critical": true, "type": "text_includes", "globs": ["*automations/*", "workflow-design.json"], "patterns": ["(?i)intake", "(?i)review", "(?i)approve"]},
    {"id": "str.sources", "group": "structure", "critical": false, "type": "text_includes", "globs": ["*automations/*", "workflow-design.json"], "patterns": ["(?i)gmail|calendar|gemini"]},

    {"id": "sig.statuses", "group": "signals", "critical": true, "type": "text_includes", "globs": ["*automations/*", "workflow-design.json"], "patterns": ["needs-review", "pending", "clarification", "approved", "rejected"]},
    {"id": "sig.classifications", "group": "signals", "critical": true, "type": "text_includes", "globs": ["*automations/*", "workflow-design.json"], "patterns": ["repo-work", "design-work", "decision-record", "already-tracked"]},
    {"id": "sig.idempotency", "group": "signals", "critical": true, "type": "text_includes", "globs": ["*automations/*", "workflow-design.json"], "patterns": ["(?i)idempoten|dedup"]},
    {"id": "sig.cursor_comment", "group": "signals", "critical": false, "type": "text_includes", "globs": ["*automations/*"], "patterns": ["cursorComment"]},
    {"id": "sig.issues_created", "group": "signals", "critical": false, "type": "text_includes", "globs": ["*automations/*"], "patterns": ["(?i)issues tab|\\bcreated\\b"]},
    {"id": "sig.capability_evidence", "group": "signals", "critical": false, "type": "text_includes", "globs": ["*automations/*"], "patterns": ["(?i)capabilit", "(?i)cit(e|ation)|evidence"]},

    {"id": "safe.intake_no_issues", "group": "safety", "critical": true, "type": "text_includes", "globs": ["*automations/*intake*"], "patterns": ["(?i)(never|do not|don't|must not) (create|open|file) (any )?(github )?issues?"]},
    {"id": "safe.human_approval", "group": "safety", "critical": true, "type": "text_includes", "globs": ["*automations/*"], "patterns": ["(?i)only (when|after|if) .{0,40}approved|human.{0,20}approv"]},
    {"id": "safe.no_anyone", "group": "safety", "critical": true, "type": "text_excludes", "globs": ["*automations/*"], "patterns": ["(?im)^\\|[^\\n]*comment[^\\n]*\\|[^\\n]*\\bAnyone\\b"]},
    {"id": "safe.protected_paths", "group": "safety", "critical": true, "type": "no_protected_writes", "globs": [".cursor/rules/*", ".cursor/hooks*", ".github/*"]},

    {"id": "route.ledger_skills", "group": "routing", "critical": true, "type": "text_includes", "globs": ["*automations/*", "workflow-design.json"], "include_transcript": true, "patterns": ["meeting-review-intake", "review-ledger-round", "approve-ledger-round"]},
    {"id": "route.capability_skills", "group": "routing", "critical": false, "type": "text_includes", "globs": ["*automations/*", "workflow-design.json"], "include_transcript": true, "patterns": ["design-capability-check|repo-context-resolver", "design-to-issue"]}
  ]
}
