{
  "checks": [
    {
      "id": "art.repo_profile",
      "group": "artifacts",
      "critical": true,
      "type": "schema_valid",
      "name": "repo-profile.json",
      "schema": "framework/schemas/repo-profile.schema.json"
    },
    {
      "id": "art.process_map",
      "group": "artifacts",
      "critical": true,
      "type": "schema_valid",
      "name": "process-map.json",
      "schema": "framework/schemas/process-map.schema.json"
    },
    {
      "id": "art.design",
      "group": "artifacts",
      "critical": true,
      "type": "schema_valid",
      "name": "workflow-design.json",
      "schema": "framework/schemas/workflow-design.schema.json"
    },
    {
      "id": "art.automations",
      "group": "artifacts",
      "critical": true,
      "type": "artifact_exists",
      "name": "*automations/*.md"
    },
    {
      "id": "str.profile_frontend",
      "group": "structure",
      "critical": true,
      "type": "json_includes",
      "name": "workflow-design.json",
      "pointer": "profile",
      "values": [
        "frontend"
      ]
    },
    {
      "id": "str.dev_and_qa",
      "group": "structure",
      "critical": true,
      "type": "json_includes",
      "name": "workflow-design.json",
      "pointer": "stages[*].id",
      "values": [
        "dev",
        "qa"
      ],
      "mode": "all"
    },
    {
      "id": "str.gate_commands",
      "group": "structure",
      "critical": true,
      "type": "text_includes",
      "globs": [
        "*automations/*",
        "workflow-design.json"
      ],
      "patterns": [
        "tailwind:build",
        "embed:css",
        "embed:component-css",
        "npm (run )?test",
        "npm run lint"
      ]
    },
    {
      "id": "str.issue_to_pr",
      "group": "structure",
      "critical": false,
      "type": "json_includes",
      "name": "workflow-design.json",
      "pointer": "stages[*].flow",
      "values": [
        "issue_to_pr"
      ]
    },
    {
      "id": "sig.routing",
      "group": "signals",
      "critical": true,
      "type": "text_includes",
      "globs": [
        "*automations/*"
      ],
      "patterns": [
        "Routing: ?qa-full",
        "Routing: ?qa-skip",
        "QA-rerun: ?add"
      ]
    },
    {
      "id": "sig.qa_verdicts",
      "group": "signals",
      "critical": true,
      "type": "text_includes",
      "globs": [
        "*automations/*"
      ],
      "patterns": [
        "## QA PASSED",
        "## QA FAILED",
        "## QA BLOCKED",
        "## QA SKIPPED"
      ]
    },
    {
      "id": "sig.fix_loop",
      "group": "signals",
      "critical": true,
      "type": "text_includes",
      "globs": [
        "*automations/*"
      ],
      "patterns": [
        "Fix applied:",
        "Max iterations reached",
        "needs-human"
      ]
    },
    {
      "id": "sig.label_pulse",
      "group": "signals",
      "critical": false,
      "type": "text_includes",
      "globs": [
        "*automations/*"
      ],
      "patterns": [
        "(?i)remove.{0,40}(then|and).{0,20}(re-?)?add"
      ]
    },
    {
      "id": "sig.conversation_surface",
      "group": "signals",
      "critical": false,
      "type": "text_includes",
      "globs": [
        "*automations/*"
      ],
      "patterns": [
        "(?i)conversation comment"
      ]
    },
    {
      "id": "sig.qa_label_only",
      "group": "signals",
      "critical": true,
      "type": "text_excludes",
      "globs": [
        "*automations/qa*"
      ],
      "patterns": [
        "(?im)^\\|(?![^\\n]*\\b(not|never|no)\\b)[^\\n]*PR opened[^\\n]*\\|"
      ]
    },
    {
      "id": "sig.qa_failed_on_dev",
      "group": "signals",
      "critical": false,
      "type": "text_includes",
      "globs": [
        "*automations/dev*"
      ],
      "patterns": [
        "qa-failed"
      ]
    },
    {
      "id": "fe.visual_evidence",
      "group": "frontend",
      "critical": true,
      "type": "text_includes",
      "globs": [
        "*automations/qa*"
      ],
      "patterns": [
        "(?i)storybook",
        "(?i)screenshot"
      ]
    },
    {
      "id": "fe.design_source",
      "group": "frontend",
      "critical": false,
      "type": "text_includes",
      "globs": [
        "*automations/*"
      ],
      "patterns": [
        "(?i)figma",
        "(?i)blueprint"
      ]
    },
    {
      "id": "fe.impact_graph",
      "group": "frontend",
      "critical": false,
      "type": "text_includes",
      "globs": [
        "*automations/*",
        "workflow-design.json"
      ],
      "patterns": [
        "(?i)reverseImpact|component-graph"
      ]
    },
    {
      "id": "safe.no_anyone",
      "group": "safety",
      "critical": true,
      "type": "text_excludes",
      "globs": [
        "*automations/*"
      ],
      "patterns": [
        "(?im)^\\|[^\\n]*comment[^\\n]*\\|[^\\n]*(?<!never )(?<!not )\\bAnyone\\b"
      ]
    },
    {
      "id": "safe.no_agent_merge",
      "group": "safety",
      "critical": true,
      "type": "text_excludes",
      "globs": [
        "*automations/*"
      ],
      "patterns": [
        "(?im)^(?![^\\n]*\\b(not|never|no|don't|must not|nor)\\b)[^\\n]*gh pr merge",
        "(?im)^(?![^\\n]*\\b(not|never|no|don't|must not|nor)\\b)[^\\n]*merge_pull_request",
        "(?im)^(?![^\\n]*\\b(not|never|no|don't|must not|nor)\\b)[^\\n]*enable auto-?merge"
      ]
    },
    {
      "id": "safe.human_merges",
      "group": "safety",
      "critical": true,
      "type": "text_includes",
      "globs": [
        "*automations/*",
        "workflow-design.json"
      ],
      "patterns": [
        "(?i)(never|do not|don't|must not) merge|humans? (always )?merges?"
      ]
    },
    {
      "id": "safe.protected_paths",
      "group": "safety",
      "critical": true,
      "type": "no_protected_writes",
      "globs": [
        ".cursor/rules/*",
        ".cursor/hooks*",
        ".github/*"
      ]
    },
    {
      "id": "route.discover_first",
      "group": "routing",
      "critical": false,
      "type": "transcript_includes",
      "patterns": [
        "(?i)workflow-discover|repo-profile"
      ]
    }
  ]
}
