{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trimble.local/framework/schemas/process-map.schema.json",
  "title": "ProcessMap",
  "description": "Written by the workflow-interview skill.",
  "type": "object",
  "required": ["stages", "approvers", "platform"],
  "properties": {
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "today": { "type": "string" },
          "owner": { "type": "string" },
          "tool": { "type": "string" },
          "pain": { "type": "string" }
        }
      }
    },
    "ready_definition": { "type": "array", "items": { "type": "string" } },
    "agent_scope": {
      "type": "object",
      "properties": {
        "take": { "type": "array", "items": { "type": "string" } },
        "never": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_for_trust": { "type": "array", "items": { "type": "string" } },
    "approvers": {
      "type": "object",
      "required": ["merge"],
      "properties": {
        "start": { "type": "string" },
        "review": { "type": "string" },
        "merge": { "type": "string" }
      }
    },
    "risk_areas": { "type": "array", "items": { "type": "string" } },
    "channels": { "type": "array", "items": { "type": "string" } },
    "platform": { "enum": ["cursor-automations", "github-actions", "other"] }
  }
}
